---
apiVersion: helm.toolkit.fluxcd.io/v2beta2
kind: HelmRelease
metadata:
  name: &app headlamp
  namespace: observability
spec:
  interval: 30m
  chart:
    spec:
      # renovate: registryUrl=https://kubernetes-sigs.github.io/headlamp/
      chart: headlamp
      version: 0.45.0
      sourceRef:
        kind: HelmRepository
        name: headlamp
        namespace: flux-system
  # Values (only non-defaults):
  #   config.inCluster: true (default) would log UI users in as a
  #   headlamp-admin SA the app bootstraps in kube-system, which has no
  #   RBAC binding -> "forbidden" on every resource. unsafeUseServiceAccountToken
  #   makes headlamp use the pod's own SA (observability/headlamp), which the
  #   chart's clusterRoleBinding already binds to cluster-admin.
  values:
    config:
      unsafeUseServiceAccountToken: true
  #
  # Chart defaults (kept): image ghcr.io/headlamp-k8s/headlamp:v0.45.0,
  # clusterRoleBinding -> cluster-admin, Service ClusterIP headlamp:80.
  # Hardening (when wanted): enable config.oidc with an issuer, or front
  # it with an auth proxy — out of scope until the kubernetes-dashboard
  # is retired.
