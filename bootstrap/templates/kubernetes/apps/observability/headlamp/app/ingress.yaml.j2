---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: headlamp
  annotations:
    hajimari.io/enable: "true"
spec:
  ingressClassName: internal
  tls:
  - hosts:
    - headlamp.${SECRET_DOMAIN}
    secretName: headlamp
  rules:
  - host: headlamp.${SECRET_DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: headlamp
            port:
              name: http
