#jinja2: trim_blocks: True, lstrip_blocks: True
---
# k3s runs kine (sqlite) in-process as the API datastore. Its autocheckpoint is
# PASSIVE-only: it recycles WAL frames but never truncates the WAL file, so after
# any write burst the state.db-wal file stays at its high-water mark forever
# (observed: 13GB). Every subsequent reboot must replay that giant WAL, which
# produces the multi-hour "Slow SQL" (2-3s per write) episode and keeps the API
# effectively degraded for the first hours after a reboot.
#
# This pod periodically runs PRAGMA wal_checkpoint(TRUNCATE) against the kine DB,
# forcing the WAL to zero and preventing unbounded growth.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kine-wal
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kine-wal
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kine-wal
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kine-wal
    spec:
      # the kine DB (server/db) only exists on the k3s primary
      nodeSelector:
        node-role.kubernetes.io/master: "true"
      containers:
        - name: kine-wal
          # python:3.11-alpine ships the sqlite3 stdlib module; the old
          # alpine + `apk add sqlite` approach never worked (the pod could
          # not reach the apk repository), so checkpoints never ran and the
          # WAL grew unchecked until it tripped the kubelet's DiskPressure
          # threshold on 2026-10-03, evicting cluster DNS (k8s-gateway)
          # and this pod and dead-locking the whole cluster's pod DNS.
          image: python:3.11-alpine
          command:
            - python3
            - -u
            - -c
          args:
            - |
              import sqlite3, time
              while True:
                  try:
                      conn = sqlite3.connect("/host/db/state.db", timeout=5)
                      result = conn.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
                      conn.close()
                      print("checkpoint:", result, flush=True)
                  except Exception as e:
                      print("checkpoint busy or error:", type(e).__name__, e, flush=True)
                  time.sleep(900)
          securityContext:
            runAsUser: 0
          volumeMounts:
            - name: kine-db
              mountPath: /host/db
      volumes:
        - name: kine-db
          hostPath:
            path: /var/lib/rancher/k3s/server/db
            type: Directory
