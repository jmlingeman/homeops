---
apiVersion: helm.toolkit.fluxcd.io/v2beta2
kind: HelmRelease
metadata:
  name: &app gitea
  namespace: home
spec:
  interval: 15m
  # The 1.22->1.27 upgrade (chart 10.6.0->12.7.0) blew through the default
  # 5m helm timeout (image pulls + postgresql-ha STS roll + DB auto-migration);
  # 20m still fell a hair short (pg STS re-roll of the post-rollback old image
  # string + primary -0 swap landed on the deadline). 30m gives real headroom
  # for future major bumps.
  timeout: 30m
  chart:
    spec:
      chart: gitea
      # 12.7.0 = Gitea 1.27.0. Image defaults moved to docker.gitea.com/gitea
      # (rootless variant, same runtime as before); redis(-cluster) subcharts were
      # replaced by valkey(-cluster) and are disabled below (level queue +
      # memory session/cache instead, frees the old redis PVCs).
      version: 12.7.0
      sourceRef:
        kind: HelmRepository
        name: gitea
        namespace: flux-system
  maxHistory: 3

  install:
    createNamespace: true
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      retries: 3
  uninstall:
    keepHistory: false
  values:
    ingress:
      enabled: true
      className: external
      annotations:
        external-dns.alpha.kubernetes.io/target: external.${SECRET_DOMAIN}
      hosts:
        - host: &host "gitea.${SECRET_DOMAIN}"
          paths:
            # Chart v12+ ignores per-path service (backend is always
            # <release>-http); path "/" (Prefix) also routes the LFS
            # endpoints (/<owner>/<repo>.info/lfs/...) to the same service.
            - path: /
              pathType: Prefix
      tls:
        - hosts:
            - *host
    persistence:
      enabled: true

    # Terminate-first rollout: the gitea PVC is a single-replica RWO volume.
    # With the chart default (maxSurge 100%, maxUnavailable 0) the new pod
    # starts before the old one stops; if the scheduler lands it on the same
    # node as the old pod, the RWO volume can't detach and the new pod hangs
    # in Init forever (deadlock, ~30m helm timeout). maxSurge 0 /
    # maxUnavailable 1 kills the old pod first, freeing the PVC; costs a
    # ~1-2min gitea downtime window during upgrades only.
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 0
        maxUnavailable: 1

    # Chart v11+ replaces the redis(-cluster) subcharts with valkey(-cluster)
    # (both enabled by default). No KV backend is needed: Gitea falls back to
    # the file-based "level" queue (stored under /data) plus in-memory
    # session/cache. Disabling also releases the old 3x 8Gi redis-cluster
    # PVCs on Longhorn (cluster is under disk pressure). Sessions are lost
    # on gitea pod restart.
    valkey:
      enabled: false
    valkey-cluster:
      enabled: false

    postgresql:
      persistence:
        enabled: true

    gitea:
      config:
        database:
          HOST: gitea-postgresql-ha-postgresql-0.gitea-postgresql-ha-postgresql-headless.home.svc.cluster.local:5432
        # Git LFS server support. Gitea 1.27 keys (checked in
        # modules/setting/lfs.go): the switch is server.LFS_START_SERVER,
        # the object store is lfs.PATH. Objects live on the persistent
        # /data PVC so they survive pod restarts/rebuilds. Served over the
        # same host via the "/" ingress path; clients just use the normal
        # gitea URL with git-lfs installed.
        server:
          LFS_START_SERVER: "true"
        lfs:
          PATH: /data/git/lfs
    postgresql-ha:
      postgresql:
        image:
          tag: 16.3.0-debian-12-r20
        # 40 x 30s = 20min reconnect window before repmgrd promotes a standby.
        # Short primary outages (STS rollouts, reboots) no longer trigger
        # cascading auto-failovers; a truly dead primary promotes after ~20min
        # (or manually: pg_promote() + repmgr.nodes/voting_term update on the new primary).
        repmgrReconnectAttempts: 40
        repmgrReconnectInterval: 30
      pgpool:
        replicaCount: 0

