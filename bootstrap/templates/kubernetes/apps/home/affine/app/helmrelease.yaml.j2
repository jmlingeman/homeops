apiVersion: helm.toolkit.fluxcd.io/v2beta2
kind: HelmRelease
metadata:
  name: affine
  namespace: home
spec:
  interval: 30m
  chart:
    spec:
      chart: app-template
      version: 3.7.3
      sourceRef:
        kind: HelmRepository
        name: bjw-s
        namespace: flux-system
  maxHistory: 2
  install:
    createNamespace: true
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      retries: 3
  uninstall:
    keepHistory: false
  values:
    # AFFiNE (toeverything) self-hosted stack: app server + Postgres(pgvector)
    # + Redis. The migration initContainer runs the predeploy script before
    # the server starts (see docs.affine.pro/self-host-affine).
    controllers:
      main:
        type: deployment
        replicas: 1
        initContainers:
          migration:
            image:
              repository: ghcr.io/toeverything/affine
              tag: stable
              imagePullPolicy: Always
            command:
              - node
              - ./scripts/self-host-predeploy.js
            env:
              TZ: ${TIMEZONE}
              REDIS_SERVER_HOST: affine-redis
              DATABASE_URL: postgresql://affine@affine-db:5432/affine
              AFFINE_INDEXER_ENABLED: 'false'
        containers:
          main:
            image:
              repository: ghcr.io/toeverything/affine
              tag: stable
              imagePullPolicy: Always
            env:
              TZ: ${TIMEZONE}
              REDIS_SERVER_HOST: affine-redis
              DATABASE_URL: postgresql://affine@affine-db:5432/affine
              AFFINE_INDEXER_ENABLED: 'false'
            ports:
              - containerPort: 3010
                name: http
                protocol: TCP
      db:
        type: statefulset
        replicas: 1
        statefulset:
          volumeClaimTemplates:
            - name: db
              accessMode: ReadWriteOnce
              size: 10Gi
              storageClass: longhorn
        containers:
          db:
            image:
              repository: pgvector/pgvector
              tag: pg16
              imagePullPolicy: IfNotPresent
            env:
              POSTGRES_USER: affine
              POSTGRES_DB: affine
              POSTGRES_HOST_AUTH_METHOD: trust
            ports:
              - containerPort: 5432
                name: db
                protocol: TCP
      redis:
        type: deployment
        replicas: 1
        containers:
          redis:
            image:
              repository: redis
              tag: '7'
              imagePullPolicy: IfNotPresent
            ports:
              - containerPort: 6379
                name: redis
                protocol: TCP
    service:
      main:
        controller: main
        ports:
          http:
            port: 3010
      db:
        controller: db
        ports:
          db:
            port: 5432
      redis:
        controller: redis
        ports:
          redis:
            port: 6379
    persistence:
      config:
        enabled: true
        type: persistentVolumeClaim
        accessMode: ReadWriteOnce
        size: 1Gi
        storageClass: longhorn
        retain: true
        advancedMounts:
          main:
            main:
              - path: /root/.affine/config
            migration:
              - path: /root/.affine/config
      storage:
        enabled: true
        type: persistentVolumeClaim
        accessMode: ReadWriteOnce
        size: 10Gi
        storageClass: longhorn
        retain: true
        advancedMounts:
          main:
            main:
              - path: /root/.affine/storage
            migration:
              - path: /root/.affine/storage
      db:
        enabled: false
        type: persistentVolumeClaim
        accessMode: ReadWriteOnce
        size: 10Gi
        storageClass: longhorn
        advancedMounts:
          db:
            db:
              - path: /var/lib/postgresql/data
    ingress:
      main:
        enabled: true
        className: internal
        hosts:
        - host: affine.${SECRET_DOMAIN}
          paths:
          - path: /
            pathType: Prefix
            service:
              name: main
              port: http
        tls:
        - hosts:
          - affine.${SECRET_DOMAIN}
        annotations:
          hajimari.io/enable: 'true'
