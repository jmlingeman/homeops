---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: &app rss-fulltext
  namespace: feeds
  labels:
    app.kubernetes.io/name: *app
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: *app
  template:
    metadata:
      labels:
        app.kubernetes.io/name: *app
    spec:
      containers:
        - name: *app
          image: smidget2k4/rss-fulltext:v6
          imagePullPolicy: IfNotPresent
          env:
            - name: ARTICLE_COOKIES
              valueFrom:
                secretKeyRef:
                  name: rss-fulltext-secret
                  key: ARTICLE_COOKIES
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            # full-article pages can be several MB of HTML each, parsed by
            # trafilatura in a 4-worker pool; give it room
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 1Gi
