---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: &app miniflux
  namespace: feeds
  labels:
    app.kubernetes.io/name: *app
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: *app
  template:
    metadata:
      labels:
        app.kubernetes.io/name: *app
    spec:
      # run as root so the longhorn volume (root-owned) is writable;
      # the miniflux image ships a non-root USER by default
      securityContext:
        runAsUser: 0
      containers:
        - name: *app
          image: quay.io/miniflux/miniflux:2.3.3
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              value: "sqlite3:///db/miniflux.db"
            - name: LISTEN_ADDR
              value: ":8080"
            - name: ADMIN_USERNAME
              value: "jesse"
            - name: ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: miniflux-secret
                  key: ADMIN_PASSWORD
            - name: LOG_LEVEL
              value: info
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            requests:
              cpu: 25m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: db
              mountPath: /db
      volumes:
        - name: db
          persistentVolumeClaim:
            claimName: miniflux
