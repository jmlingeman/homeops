# Runtime credentials for bin/cluster-healthcheck.py, bin/issue-sync.py and the
# truenas-mcp server. Copy to `secrets/.env`, fill in, chmod 600.
#
#   cp secrets/.env.example secrets/.env && chmod 600 secrets/.env
#
# The real `secrets/.env` is git-ignored (see .gitignore). NEVER commit real
# values; the health-check report and all committed files must stay free of
# keys/tokens/passwords.

# --- TrueNAS SCALE (NAS at nas.local) --------------------------------------
# Base URL of the NAS (no trailing path). The API lives under /api/v2.0/.
NAS_API_URL=https://nas.local
# Long-term API key (TrueNAS UI → Credentials → API Keys). Read-only usage here.
NAS_API_KEY=<true…key>

# --- Self-hosted Gitea (homeops issue tracker + report mirror) -------------
# Canonical source: ~/workspace/skills/gitea/.env (single source of truth).
# Keep these in sync if the token is rotated.
GITEA_URL=https://gitea.jesseisageek.com
GITEA_USER=jesse
GITEA_EMAIL=jesse@jesseisageek.com
GITEA_TOKEN=<gitea…ken>
# Repo that holds the weekly issues + generated reports.
GITEA_REPO=homeops
